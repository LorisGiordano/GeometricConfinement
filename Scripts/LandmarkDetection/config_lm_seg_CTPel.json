{
    "short_description":    "Test1: CTPel",
    "dataset_directory":    "Dataset101_CTPel_r20",
    "model_directory":      "LandmarkDetection/SwinUNETR",
                            
    "model":               {"model_type": "SwinUNETR",
                            "patch_size": [128, 96, 128],
                            "image_resolution": [2.0, 2.0, 2.0],
                            "spatial_dims": 3,
                            "in_channels": 1,
                            "out_channels_seg": [1],
                            "merged": true,
                            "out_channels_lm": [0,2,4],
                            "inference": "SlidingWindow",
                            
                            "radius": 2,
                            "depths": [2, 2, 2, 2],
                            "num_heads": [3, 6, 12, 24],
                            "feature_size": 24,
                            "norm_name": "instance",
                            "drop_rate": 0.1,
                            "attn_drop_rate": 0.0},
                            
    "training":            {"partition": [70, 15, 15],
                            "crossvalidation": false,
                            "batch_size": 2,
                            "amount_epochs": 500,
                            "validation_interval": 5,
                            
                            "GeoCon": "confinement_config",
                            "loss_function": ["DiceCELoss", "DiceCELoss"],
                            "learning_rate": 0.01,
                            "learning_rate_scheduler": "Polynomial",
                            "optimizer": "SGD",
                            "validation_metric": ["DiceMetric", "DiceMetric"]},
                            
    "data_augmentations":  {"affine": true,
                            "elastic": false,
                            "flip": false,
                            
                            "gaussian_noise": true,
                            "gaussian_blur": true,
                            "scale_intensity": true,
                            "shift_intensity": true,
                            "simulate_low_resolution": false,
                            "gamma_correction": true},
                            
    "post_processing":     {"activation": true, 
                            "discrete": true, 
                            "fill_holes": false, 
                            "largest_component": false}
}